{
  "name": "thakyo-site",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "build:pages": "node scripts/build-pages.mjs",
    "start": "next start --hostname 0.0.0.0",
    "lint": "biome lint src --error-on-warnings",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write src docs README.md *.json *.mjs *.ts"
  },
  "dependencies": {
    "lucide-react": "1.55.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "^3.6.2",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.3",
    "@biomejs/biome": "2.5.15"
  }
}
